# Copy this file to .env and fill in the secrets: cp .env.example .env

# --- Recommendation service ---

# HTTP port of the service
PORT=3000

# Elasticsearch address (inside docker compose use https://es01:9200)
ELASTIC_URL=https://localhost:9200

# Index for user documents
ELASTIC_INDEX=users

# Skip TLS verification for the self-signed certificates of the local cluster
ELASTIC_INSECURE_SKIP_VERIFY=true

# User service that fake users are mirrored to (empty disables it)
USER_SERVICE_URL=http://localhost:8080

# --- Elastic stack (docker-compose.yml) ---

# User of elasticsearch
ELASTIC_USER=elastic

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=changeme

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=changeme

# Version of Elastic products
STACK_VERSION=9.2.1

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824

# Project namespace (defaults to the current folder name if not set)
#COMPOSE_PROJECT_NAME=myproject
